# SMTP Configuration
# Leave SMTP_HOST blank to disable email alerts (recommended until configured;
# a placeholder host makes every run fail a DNS lookup).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_app_password
SMTP_USE_TLS=true
ALERT_RECIPIENTS=your_email@example.com

# Schedule (comma-separated HH:MM in IST)
SCHEDULE_TIMES=09:00,16:00

# Polling interval in minutes (0 to disable)
POLL_INTERVAL_MINUTES=0

# Logging
LOG_LEVEL=INFO

# Apollo.io (contact enrichment — free tier: 10K credits/year)
APOLLO_API_KEY=your_apollo_api_key
APOLLO_RATE_LIMIT_PER_MINUTE=10

# Prospeo (fallback enrichment — free tier: 75/month)
PROSPEO_API_KEY=your_prospeo_api_key

# Job aggregator APIs — all free tiers; the scraper is skipped while a key is blank
# Adzuna:   https://developer.adzuna.com/  (app_id + app_key)
# Jooble:   https://jooble.org/api/about   (key issued by email)
# Careerjet: https://www.careerjet.com/partners/api/  (affiliate id)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_API_KEY=
CAREERJET_AFFID=

# MNC careers scraping — defaults shown; override only if needed
# MNC_MAX_POSTINGS=3000
# MNC_API_CONCURRENCY=12
# MNC_HTML_CONCURRENCY=5
# MNC_COMPANY_TIMEOUT=420

# Gmail OAuth (outreach sending)
# Download credentials.json from Google Cloud Console → APIs & Services → Credentials
GMAIL_CREDENTIALS_PATH=credentials/gmail_credentials.json
GMAIL_TOKEN_PATH=credentials/gmail_token.json

# Outreach settings
OUTREACH_DAILY_LIMIT=25
OUTREACH_SENDER_NAME=Your Name
OUTREACH_SENDER_LINKEDIN=https://www.linkedin.com/in/yourprofile
OUTREACH_EXPERIENCE_YEARS=6
OUTREACH_DOMAIN_EXPERTISE=B2B SaaS
OUTREACH_ONE_LINE_PITCH=I've led 0-to-1 product launches at X and scaled Y to Z users

# --- Job enrichment (local LLM via Ollama; optional) ---
# brew install ollama && brew services start ollama && ollama pull qwen2.5:3b
LLM_ENRICH_ENABLED=true
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
