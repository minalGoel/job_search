# SMTP Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_app_password
SMTP_USE_TLS=true
ALERT_RECIPIENTS=your_email@example.com

# Schedule (comma-separated HH:MM in IST)
SCHEDULE_TIMES=09:00,16:00

# Polling interval in minutes (0 to disable)
POLL_INTERVAL_MINUTES=0

# Logging
LOG_LEVEL=INFO

# Apollo.io (contact enrichment — free tier: 10K credits/year)
APOLLO_API_KEY=your_apollo_api_key
APOLLO_RATE_LIMIT_PER_MINUTE=10

# Prospeo (fallback enrichment — free tier: 75/month)
PROSPEO_API_KEY=your_prospeo_api_key

# Gmail OAuth (outreach sending)
# Download credentials.json from Google Cloud Console → APIs & Services → Credentials
GMAIL_CREDENTIALS_PATH=credentials/gmail_credentials.json
GMAIL_TOKEN_PATH=credentials/gmail_token.json

# Outreach settings
OUTREACH_DAILY_LIMIT=25
OUTREACH_SENDER_NAME=Your Name
OUTREACH_SENDER_LINKEDIN=https://www.linkedin.com/in/yourprofile
OUTREACH_EXPERIENCE_YEARS=6
OUTREACH_DOMAIN_EXPERTISE=B2B SaaS
OUTREACH_ONE_LINE_PITCH=I've led 0-to-1 product launches at X and scaled Y to Z users
